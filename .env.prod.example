# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and replace every
# change-me value; `openssl rand -base64 36` makes a good one. Do not reuse the development .env.

# The public host name. DNS must point at this server before Let's Encrypt can issue a certificate.
DOMAIN=fleet.example.com
# Where Let's Encrypt sends expiry warnings. Leave empty to stay on a self-signed certificate (testing).
LETSENCRYPT_EMAIL=
# Set to 1 while trying things out: staging certificates are not trusted but have no rate limit.
LETSENCRYPT_STAGING=

# Dashboard logins. JWT_SECRET needs at least 32 characters. The admin is created on the first start only.
JWT_SECRET=change-me-to-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# PostgreSQL / TimescaleDB (the password is fixed when the data volume is first created)
POSTGRES_DB=fleettwin
POSTGRES_USER=fleettwin
POSTGRES_PASSWORD=change-me-postgres

# Mosquitto. Devices use these too if MQTT over TLS is published (docker-compose.mqtt-tls.yml).
MQTT_USERNAME=fleettwin
MQTT_PASSWORD=change-me-mqtt
MQTT_TLS_PORT=8883

# MinIO: ML models, generated reports and database backups (password: at least 8 characters)
MINIO_ROOT_USER=fleettwin
MINIO_ROOT_PASSWORD=change-me-minio

# Redis
REDIS_PASSWORD=change-me-redis

# Map region for route optimisation: any .osm.pbf extract that covers where the fleet drives.
OSRM_PBF_URL=https://download.openstreetmap.fr/extracts/asia/india/karnataka-latest.osm.pbf

# Database backups to MinIO
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Weekly reports by email (optional)
REPORTS_EMAIL_ENABLED=false
REPORTS_EMAIL_TO=
REPORTS_EMAIL_FROM=fleet-twin@fleet.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Only for `--profile demo` (simulated vehicles) and `--profile monitoring` (Prometheus + Grafana)
SIM_FAULT_RATE=0.02
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
