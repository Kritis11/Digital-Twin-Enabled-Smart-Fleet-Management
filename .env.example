# Copy to .env and change every password before using outside your laptop.

# PostgreSQL / TimescaleDB
POSTGRES_DB=fleettwin
POSTGRES_USER=fleettwin
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Mosquitto
MQTT_USERNAME=fleettwin
MQTT_PASSWORD=change-me-mqtt
MQTT_PORT=1883

# MinIO (password must be at least 8 characters)
MINIO_ROOT_USER=fleettwin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# Dashboard logins. JWT_SECRET signs the tokens: at least 32 characters, e.g. `openssl rand -base64 48`.
# ADMIN_USERNAME / ADMIN_PASSWORD (10+ characters) create the first admin while the users table is empty;
# after that they are ignored and users are managed in the dashboard.
JWT_SECRET=change-me-to-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# OSRM (road distances for route optimisation). Any .osm.pbf extract works; a new URL is downloaded
# and prepared on the next `docker compose up -d`. Bigger regions need more memory and time.
OSRM_PBF_URL=https://download.openstreetmap.fr/extracts/asia/india/karnataka-latest.osm.pbf
OSRM_PORT=5001

# Simulator (CLI args override these)
SIM_VEHICLES=5
SIM_INTERVAL=2
SIM_FAULT_RATE=0.02
