# Copy to .env and change every password before using outside your laptop.

# PostgreSQL / TimescaleDB
POSTGRES_DB=fleettwin
POSTGRES_USER=fleettwin
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Mosquitto
MQTT_USERNAME=fleettwin
MQTT_PASSWORD=change-me-mqtt
MQTT_PORT=1883

# MinIO (password must be at least 8 characters)
MINIO_ROOT_USER=fleettwin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# Simulator (CLI args override these)
SIM_VEHICLES=5
SIM_INTERVAL=2
SIM_FAULT_RATE=0.02
