# Rendered at container start: ${DOMAIN} and ${LOGIN_RATE_PER_MINUTE} come from the environment.

# Docker's DNS, asked at request time: nginx can start before the backend does and follows it when
# the backend container is replaced by a new version.
resolver 127.0.0.11 valid=10s;

server_tokens off;   # do not advertise the nginx version

# Slows down password guessing: this many login attempts a minute per client address (default 10).
limit_req_zone $binary_remote_addr zone=login:10m rate=${LOGIN_RATE_PER_MINUTE}r/m;

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge, answered from the directory certbot writes to.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Maintained by 15-certificate.sh: the Let's Encrypt certificate once there is one, self-signed until then.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    # Scripts only from this origin, no plugins, no framing. Styles need 'unsafe-inline' for Angular's
    # component styles and Leaflet's positioning; images also come from the OpenStreetMap tile servers.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' wss://${DOMAIN}; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    client_max_body_size 1m;
    gzip on;
    gzip_types text/css application/javascript application/json;

    root /usr/share/nginx/html;
    set $backend http://backend:8080;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # route optimisation and reports take a few seconds
    }

    # STOMP over WebSocket
    location /ws {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    # Build files have a content hash in their name, so they can be cached for a year; index.html must not be.
    # (`expires`, not add_header: an add_header here would switch off the security headers above.)
    location ~* \.(?:js|css|woff2?|png|svg|ico)$ { expires 1y; }
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;   # the Angular router handles the path
    }
}
